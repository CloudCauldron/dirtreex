%% ============================================================
%%  Booleans
%% ============================================================
\newif\ifdte@showbox    \dte@showboxtrue
\newif\ifdte@pagebreak  \dte@pagebreaktrue
\newif\ifdte@splitflag
%% True from environment entry through capture, rendering and output.
%% The six constructors use it for an outside-environment diagnostic;
%% it is not a capture-only admission gate. If error processing continues,
%% their existing storage code still runs.
\newif\ifdte@inenv
\newif\ifdte@columns
%% Raised (globally) when an entry's page or required column
%% position is not yet available from the .aux file. Consumed by
%% the \AtEndDocument hook at the bottom of this file, which emits
%% a single "Rerun LaTeX..." \PackageWarningNoLine so that latexmk
%% and rerunfilecheck know to schedule another pass.
\newif\ifdte@needrerun
%% Raised the first time \dte@findanchor's recursion-floor branch
%% fires within an env (depth sequence malformed -- see the floor
%% guard inside \dte@findanchor below). Suppresses subsequent
%% warnings within the same env so the per-render
%% `dte@findanchor hit the recursion floor' \PackageWarning fires
%% at most once per environment. Reset to false by
%% \dte@flush@state at env open. \newif's setters use a bare \let
%% (plain.tex L264-269), so the package convention of
%% \global\dte@floorwarnedtrue / \global\dte@floorwarnedfalse must
%% be used at every assignment site -- otherwise the assignment
%% rolls back at the env's outer \endgroup and the flag silently
%% leaks across env boundaries. Matches \global\dte@needreruntrue
%% above.
\newif\ifdte@floorwarned
%% Raised by the `tree break at' pgfkeys handler so
%% \dte@breakat@phase{post} can distinguish a user-supplied
%% override (which must survive `box=false') from the package-default
%% 1em that \dte@breakat@phase{pre} stamps on every env entry.
%% Without this flag a user writing `[box=false]' would silently
%% inherit `tree break at = 1em' (the box=true default) because the
%% defaults macro runs before pgfkeys flips the showbox flag, leaving
%% `tbA / tbB' = 1em with no way to tell `default' from `user'.
%% Reset to false at every env entry; set true inside the `tree
%% break at' handler.
\newif\ifdte@tbset

